{
  "name": "mobitrace.io",
  "version": "1.5.31",
  "author": "MarsBased",
  "scripts": {
    "dev:next": "next dev --experimental-https",
    "dev": "run-p dev:*",
    "build": "next build",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "rimraf .next out coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "next typegen && tsc --noEmit --pretty",
    "test": "vitest run",
    "generate:api": "./scripts/api-get.sh && ./scripts/api-build.sh",
    "generate:tokens-css": "node scripts/generate-tokens-css.mjs",
    "generate:icons": "svgr --config-file .svgrrc.js --out-dir src/components/ui/icon/icons -- src/components/ui/icon/svgs && prettier --write src/components/ui/icon/icons && eslint --fix src/components/ui/icon/icons",
    "lokalise:upload": "tsx src/tasks/upload-translations.ts",
    "lokalise:download": "tsx src/tasks/download-translations.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check-types && npm run lint && npm run format:check && npm run test && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@stripe/react-stripe-js": "^2.9.0",
    "@stripe/stripe-js": "^4.10.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/functions": "^3.9.3",
    "@vis.gl/react-google-maps": "^1.9.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "countries-list": "^3.4.1",
    "country-flag-icons": "^1.6.20",
    "embla-carousel-react": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "iron-session": "^8.0.4",
    "isbot": "^5.2.1",
    "jwt-decode": "^4.0.0",
    "libphonenumber-js": "^1.13.10",
    "lucide-react": "^0.453.0",
    "next": "^16.3.0",
    "next-intl": "^4.13.6",
    "next-safe-action": "^8.6.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "path-to-regexp": "^8.4.2",
    "private-ip": "^3.0.2",
    "puppeteer": "^24.22.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-phone-number-input": "^3.4.17",
    "react-transition-group": "^4.4.5",
    "sharp": "^0.35.3",
    "simple-icons": "^16.28.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "ua-parser-js": "^2.0.10",
    "validator": "^13.15.35",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lokalise/node-api": "^16.3.0",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/nextjs-vite": "^10.5.8",
    "@svgr/cli": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/google.maps": "^3.65.5",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/expect": "^4.1.10",
    "adm-zip": "^0.6.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "npm-run-all": "^4.1.5",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "start-server-and-test": "^3.0.12",
    "storybook": "^10.5.8",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "vitest-fail-on-console": "^0.10.1"
  },
  "overrides": {
    "@stripe/react-stripe-js": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
