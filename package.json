{
  "name": "mobitrace.io",
  "version": "1.5.31",
  "author": "MarsBased",
  "scripts": {
    "dev:next": "next dev --experimental-https",
    "dev": "run-p dev:*",
    "build": "next build",
    "start": "next start",
    "clean": "rimraf .next out coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit --pretty",
    "test": "vitest run",
    "generate:icons": "svgr --config-file .svgrrc.js --out-dir src/components/ui/icon/icons -- src/components/ui/icon/svgs",
    "lokalise:upload": "tsx src/tasks/upload-translations.ts",
    "lokalise:download": "tsx src/tasks/download-translations.ts"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^1.16.8",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@radix-ui/react-visually-hidden": "^1.1.0",
    "@stripe/react-stripe-js": "^2.9.0",
    "@stripe/stripe-js": "^4.10.0",
    "@t3-oss/env-nextjs": "^0.11.1",
    "@tanstack/react-query": "^5.59.20",
    "@types/puppeteer": "^5.4.7",
    "@vercel/functions": "^1.5.0",
    "@vis.gl/react-google-maps": "^1.4.1",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "countries-list": "^3.1.1",
    "country-flag-icons": "^1.5.13",
    "embla-carousel-react": "^8.3.1",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "isbot": "^5.1.22",
    "libphonenumber-js": "^1.11.12",
    "lucide-react": "^0.453.0",
    "next": "^14.2.35",
    "next-auth": "5.0.0-beta.28",
    "next-intl": "^3.26.3",
    "private-ip": "^3.0.2",
    "puppeteer": "^24.22.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "react-phone-number-input": "^3.4.12",
    "react-transition-group": "^4.4.5",
    "sharp": "^0.33.5",
    "simple-icons": "^13.14.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "ua-parser-js": "^2.0.6",
    "validator": "^13.15.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.27.3",
    "@eslint-react/eslint-plugin": "^1.15.0",
    "@lokalise/node-api": "^13.0.0",
    "@next/eslint-plugin-next": "^14.2.15",
    "@svgr/cli": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/nesting": "^0.0.0-insiders.565cd3e",
    "@tanstack/eslint-plugin-query": "^5.60.1",
    "@testing-library/jest-dom": "^6.6.1",
    "@testing-library/react": "^16.0.1",
    "@types/adm-zip": "^0.5.7",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^22.7.6",
    "@types/react": "^18.3.11",
    "@types/validator": "^13.15.2",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^2.1.3",
    "@vitest/expect": "^2.1.3",
    "adm-zip": "^0.5.16",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.6",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "eslint-plugin-format": "^0.1.2",
    "eslint-plugin-jest-dom": "^5.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-tailwindcss": "^3.17.5",
    "eslint-plugin-testing-library": "^6.3.0",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.47",
    "postcss-import": "^16.1.0",
    "postcss-scss": "^4.0.9",
    "rimraf": "^6.0.1",
    "semantic-release": "^24.1.2",
    "start-server-and-test": "^2.0.8",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.1.3",
    "vitest-fail-on-console": "^0.7.1"
  },
  "prettier": {
    "singleQuote": true
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ],
    "rules": {
      "at-rule-no-unknown": [
        true,
        {
          "ignoreAtRules": [
            "layer",
            "tailwind",
            "apply",
            "variants"
          ]
        }
      ],
      "function-no-unknown": [
        true,
        {
          "ignoreFunctions": [
            "theme"
          ]
        }
      ],
      "custom-property-pattern": null,
      "import-notation": null,
      "no-descending-specificity": null,
      "media-query-no-invalid": null
    }
  }
}
