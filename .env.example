NEXT_PUBLIC_LANGUAGES_VERSION=1
NEXT_PUBLIC_CURRENCY_VERSION=2
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="<your-google-maps-api-key>"
NEXT_PUBLIC_API_URL=https://mobitrace-backend.marsbased.com/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="<your-stripe-publishable-key>"
NEXT_PUBLIC_USE_LEMON_STRIPE=0
NEXT_PUBLIC_LEMON_STRIPE_PUBLISHABLE_KEY="<your-stripe-publishable-key>"
NEXT_PUBLIC_GTM_ID=GTM-NTXVB7ZV
# The new API the session's tokens are issued by, e.g. https://api.ignastrace.io
API_BASE_URL="<your-api-base-url>"
# The Payments microservice — a second upstream, with its own specification and its own
# generation command (`npm run generate:payments-api`). It declares its paths bare and keeps its
# version prefix in the specification's `servers` field, so the prefix belongs here in the value.
# TEMPORARY: the resumewise development instance is the only payments instance that answers
# today; this variable is where that changes once Ignastrace has one of its own.
PAYMENTS_API_BASE_URL=https://dev.resumewise.com/api/payments/v1
# Seals the session cookie. At least 32 characters; rotating it signs everyone out.
SESSION_PASSWORD="<at-least-32-characters-of-random-secret>"
IPSTACK_API_KEY="<your-ipstack-api-key>"
LOKALISE_API_TOKEN="<your-lokalise-api-token>"
LOKALISE_PROJECT_ID=14240418673f52ae29a007.74392007

# Feature flags. Read on the server by `src/settings` and handed to the browser as
# settled settings, so none of them needs a NEXT_PUBLIC_ prefix. Both `1` and
# `true` count as on; anything else, including unset, is off.
FEATURE_UPSELLS=
FEATURE_REQUEST_ZIP=
FEATURE_ADYEN_GPAY=
FEATURE_EXPRESS_CHECKOUT_AUTO=
# The QA widget that sets the override cookies. Never on where visitors are served.
FEATURE_TEST_WIDGET=
